{
  "name": "casa-da-india",
  "version": "0.4.6",
  "private": true,
  "description": "casa_da_indIA — um enxame local de agentes de IA, à maneira da Casa da Índia: o Feitor despacha, as naus partem, e tudo se regista. Fork português de Munder Difflin.",
  "main": "out/main/index.js",
  "author": "Diogo Cunha Moreira",
  "homepage": "https://github.com/DiogoCunhaMoreira/casa_da_indIA",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiogoCunhaMoreira/casa_da_indIA.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "arte": "node tools/mapgen/run.cjs",
    "cena": "vite --config vite.cena.config.ts",
    "build": "npm run godot:export && electron-vite build && npm run copy:main-assets",
    "copy:main-assets": "node tools/copy-main-assets.cjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f && node tools/ensure-pty-perms.cjs && node tools/patch-node-pty-conpty.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:focused": "node --test test/*.test.cjs",
    "check:links": "node tools/check-release-links.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "godot:export": "node tools/godot/export.cjs",
    "build:godot": "npm run build",
    "test:godot": "electron tools/godot/smoke.cjs",
    "predev": "npm run godot:export",
    "godot:portraits": "node tools/godot/portraits.cjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@openai/agents-realtime": "^0.11.8",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.10.0",
    "commit-graph": "^2.4.0",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "localtunnel": "^2.0.2",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "pixi.js": "^8.5.1",
    "posthog-node": "^5.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tunnelmole": "^2.4.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/rebuild": "$@electron/rebuild"
    }
  }
}
